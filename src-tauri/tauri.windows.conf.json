{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mash",
        "width": 1100,
        "height": 702,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/adb/adb.exe": "resources/adb/adb.exe",
      "resources/adb/AdbWinApi.dll": "resources/adb/AdbWinApi.dll",
      "resources/adb/AdbWinUsbApi.dll": "resources/adb/AdbWinUsbApi.dll",
      "resources/adb/NOTICE.txt": "resources/adb/NOTICE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4MzRBQjM3NjcxNEQwNzYKUldSMjBCUm5ONnMwaUNqeHU1cExrZkdqUEwxZUJJREhia0t6YXRzS1IyQlhYZGQ1UzdleVdwdk0K",
      "endpoints": [
        "https://mash.xiaotongx.com/mash/releases/windows-stable/latest.json"
      ]
    }
  }
}
